      { id:2, em:'ðŸ’§', name: lang==='en' ? 'Piped Drinking Water Connection'  : 'à¤¨à¤³ à¤ªà¤¾à¤£à¥€ à¤ªà¥à¤°à¤µà¤ à¤¾ à¤¯à¥‹à¤œà¤¨à¤¾',     loc:'Wards 2 & 5',     dept: lang==='en' ? 'Water Works'    : 'à¤œà¤²à¤¸à¤‚à¤ªà¤¦à¤¾',       pct:100, budget:35.0, st:'Completed'   },
