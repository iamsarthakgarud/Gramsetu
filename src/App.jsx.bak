                  <th>{lang === 'en' ? 'Description' : 'à¤¤à¤•à¥à¤°à¤¾à¤° à¤µà¤°à¥à¤£à¤¨'}</th>
                  <th>{lang === 'en' ? 'Attachment' : 'à¤«à¥‹à¤Ÿà¥‹ à¤ªà¥à¤°à¤¾à¤µà¤¾'}</th>
                  <th>{lang === 'en' ? 'Date' : 'à¤¤à¤¾à¤°à¥€à¤–'}</th>
                  <th>{lang === 'en' ? 'Status' : 'à¤¸à¥à¤¥à¤¿à¤¤à¥€'}</th>
                  <th>{lang === 'en' ? 'Action' : 'à¤•à¥ƒà¤¤à¥€'}</th>
                </tr>
              </thead>
              <tbody>
                {filteredComplaints.map(item => (
                  <tr key={item.id}>
                    <td>#{item.id}</td>
