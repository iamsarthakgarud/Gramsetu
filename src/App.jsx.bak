                        <span style={{ color: 'var(--brand-teal)', fontWeight: 600 }}>âœ“ {lang === 'en' ? 'Completed' : 'à¤ªà¥‚à¤°à¥à¤£ à¤à¤¾à¤²à¥‡'}</span>
