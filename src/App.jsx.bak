          </div>
        </div>

        {/* Treasury fund allocation adjusting sliders */}
        <div className="admin-card">
          <h3 className="admin-card-title">ðŸ’° {lang === 'en' ? 'Treasury Audit & Budget Adjuster' : 'à¤¬à¤œà¥‡à¤Ÿ à¤µà¤¾à¤Ÿà¤ª à¤µ à¤–à¤°à¥à¤š à¤¨à¤¿à¤¯à¤‚à¤¤à¥à¤°à¤£'}</h3>
          <p style={{ fontSize: '0.85rem', color: 'var(--dark-text-muted)', textAlign: 'left', marginTop: '-1rem' }}>
            {lang === 'en' 
              ? 'Update the Gram Panchayat allocations across developmental sectors. Updates display live on the citizen dashboard.' 
              : 'à¤—à¥à¤°à¤¾à¤®à¤ªà¤‚à¤šà¤¾à¤¯à¤¤à¥€à¤šà¥à¤¯à¤¾ à¤µà¤¿à¤µà¤¿à¤§ à¤•à¥à¤·à¥‡à¤¤à¥à¤°à¤¾à¤‚à¤¸à¤¾à¤ à¥€ à¤…à¤¸à¤²à¥‡à¤²à¥à¤¯à¤¾ à¤¬à¤œà¥‡à¤Ÿà¤šà¥‡ à¤µà¤¾à¤Ÿà¤ª à¤•à¤°à¤¾. à¤¯à¥‡à¤¥à¥‡ à¤•à¥‡à¤²à¥‡à¤²à¥‡ à¤¬à¤¦à¤² à¤¥à¥‡à¤Ÿ à¤¨à¤¾à¤—à¤°à¤¿à¤• à¤ªà¥‹à¤°à¥à¤Ÿà¤²à¤µà¤° à¤…à¤ªà¤¡à¥‡à¤Ÿ à¤¹à¥‹à¤¤à¥€à¤².'}
          </p>
          <div className="budget-sliders">
            {sectors.map(sec => {
              const data = fundsData[sec]
              const alloc = data ? data.allocated : 0
              const spent = data ? data.spent : 0
              
              return (
                <div key={sec} className="budget-slider-group">
                  <div className="budget-slider-info">
                    <span className="budget-slider-label">
                      ðŸ› ï¸ {lang === 'en' ? sec.replace(/([A-Z])/g, ' $1').trim() : (sec === 'Infrastructure' ? 'à¤ªà¤¾à¤¯à¤¾à¤­à¥‚à¤¤ à¤¸à¥à¤µà¤¿à¤§à¤¾' : sec === 'WaterSupply' ? 'à¤ªà¤¾à¤£à¥€ à¤ªà¥à¤°à¤µà¤ à¤¾' : sec === 'Education' ? 'à¤¶à¤¿à¤•à¥à¤·à¤£' : sec === 'SocialWelfare' ? 'à¤¸à¤®à¤¾à¤œ à¤•à¤²à¥à¤¯à¤¾à¤£' : 'à¤•à¥ƒà¤·à¥€ à¤µà¤¿à¤­à¤¾à¤—')}
                    </span>
                    <span style={{ fontWeight: 700 }}>
                      {spent}L Spent / <span className="text-brand-gradient">{alloc}L Allocated</span>
                    </span>
                  </div>
                  <input 
                    type="range" 
                    className="budget-slider"
                    min={spent}
                    max="150"
                    value={alloc}
                    onChange={(e) => {
                      const newVal = parseInt(e.target.value)
                      setFundsData(prev => ({
                        ...prev,
                        [sec]: { ...prev[sec], allocated: newVal }
                      }))
                      fetch('/api/funds', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ sector: sec, allocated: newVal })
                      })
                        .catch(err => console.error("Error updating fund allocation:", err))
                    }}
                  />
                </div>
              )
            })}
          </div>
        </div>
      </div>
    )
  }

  const renderDocumentsTab = () => {
    const handleDocumentAction = (id, newStatus, requestDetails) => {
      fetch('/api/doc-requests/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            setDocRequests(prev => prev.map(req => req.id === id ? { ...req, status: newStatus } : req))
            
            if (newStatus === 'Approved' && canvasRef.current) {
              // Draw and download the certificate
              const matchedDoc = documentsList.find(d => d.id === requestDetails.docType)
              if (matchedDoc) {
                drawCertificate(canvasRef.current, matchedDoc, requestDetails.applicantName, lang)
                
                // Add signature sign simulation on canvas
                const canvas = canvasRef.current
                const ctx = canvas.getContext('2d')
                ctx.font = 'bold italic 12px "Outfit", sans-serif'
                ctx.fillStyle = '#064e3b'
                ctx.textAlign = 'right'
                ctx.fillText(`Digitally signed by Gram Sevak Sunita Deshmukh on ${new Date().toLocaleDateString()}`, canvas.width - 70, 510)
                
                const url = canvas.toDataURL('image/png')
                const link = document.createElement('a')
                link.download = `Signed_${matchedDoc.id}_Certificate_${requestDetails.applicantName.trim().replace(/\s+/g, '_')}.png`
                link.href = url
                link.click()
              }
            }
          }
        })
        .catch(err => console.error("Error updating document request status:", err))
    }

    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: '2rem', width: '100%' }}>
        <div className="admin-card">
          <h3 className="admin-card-title">ðŸ“œ {lang === 'en' ? 'Digital Certificate Requests Review Queue' : 'à¤¦à¤¾à¤–à¤²à¤¾ à¤ªà¥à¤°à¤®à¤¾à¤£à¤ªà¤¤à¥à¤° à¤µà¤¿à¤¤à¤°à¤£ à¤°à¤¾à¤‚à¤—'}</h3>
          <div className="admin-table-wrapper">
            <table className="admin-table">
              <thead>
                <tr>
                  <th>{lang === 'en' ? 'ID' : 'à¤•à¥à¤°.'}</th>
                  <th>{lang === 'en' ? 'Applicant' : 'à¤…à¤°à¥à¤œà¤¦à¤¾à¤°'}</th>
                  <th>{lang === 'en' ? 'Document Type' : 'à¤¦à¤¾à¤–à¤²à¥à¤¯à¤¾à¤šà¤¾ à¤ªà¥à¤°à¤•à¤¾à¤°'}</th>
                  <th>{lang === 'en' ? 'Purpose' : 'à¤•à¤¾à¤°à¤£'}</th>
                  <th>{lang === 'en' ? 'ID Proof Attachment' : 'à¤“à¤³à¤–à¤ªà¤¤à¥à¤° à¤ªà¥à¤°à¤¾à¤µà¤¾'}</th>
                  <th>{lang === 'en' ? 'Submission Date' : 'à¤…à¤°à¥à¤œ à¤¤à¤¾à¤°à¥€à¤–'}</th>
                  <th>{lang === 'en' ? 'Status' : 'à¤¸à¥à¤¥à¤¿à¤¤à¥€'}</th>
                  <th>{lang === 'en' ? 'Action' : 'à¤•à¥ƒà¤¤à¥€'}</th>
                </tr>
              </thead>
              <tbody>
                {docRequests.map(req => (
                  <tr key={req.id}>
                    <td>#{req.id}</td>
                    <td><strong style={{ color: '#fff' }}>{req.applicantName}</strong></td>
                    <td>
                      <span style={{ color: 'var(--brand-teal)', fontWeight: 600 }}>
                        {lang === 'en' ? req.docTitleEn : req.docTitleMr}
                      </span>
                    </td>
                    <td>{req.purpose}</td>
                    <td>
                      {req.idProofPreview ? (
                        <img 
                          src={req.idProofPreview} 
                          alt="ID Verification" 
                          className="table-img-thumb"
                          onClick={() => setLightboxImg(req.idProofPreview)}
                        />
                      ) : (
                        <span style={{ color: 'var(--dark-text-muted)' }}>None</span>
                      )}
                    </td>
                    <td>{req.date}</td>
                    <td>
                      <span className={`badge-status ${req.status === 'Approved' ? 'approved' : (req.status === 'Rejected' ? 'rejected' : 'pending')}`}>
                        {req.status === 'Approved' ? (lang === 'en' ? 'Issued' : 'à¤µà¤¿à¤¤à¤°à¤¿à¤¤') 
                         : req.status === 'Rejected' ? (lang === 'en' ? 'Rejected' : 'à¤¨à¤¾à¤•à¤¾à¤°à¤²à¥‡') 
                         : (lang === 'en' ? 'Pending' : 'à¤ªà¥à¤°à¤²à¤‚à¤¬à¤¿à¤¤')}
                      </span>
                    </td>
                    <td>
                      {req.status === 'Pending' ? (
                        <div style={{ display: 'flex', gap: '0.35rem' }}>
                          <button 
                            className="btn btn-primary" 
                            style={{ padding: '0.4rem 0.75rem', fontSize: '0.75rem', borderRadius: '8px' }}
                            onClick={() => handleDocumentAction(req.id, 'Approved', req)}
                          >
                            âœ“ {lang === 'en' ? 'Approve & Issue' : 'à¤®à¤‚à¤œà¥‚à¤° à¤•à¤°à¤¾'}
                          </button>
                          <button 
                            className="btn btn-secondary" 
                            style={{ padding: '0.4rem 0.75rem', fontSize: '0.75rem', borderRadius: '8px', borderColor: '#ef4444', color: '#ef4444' }}
                            onClick={() => handleDocumentAction(req.id, 'Rejected', req)}
                          >
                            âœ— {lang === 'en' ? 'Reject' : 'à¤¨à¤¾à¤•à¤¾à¤°à¤¾'}
                          </button>
                        </div>
                      ) : (
                        <span style={{ fontWeight: 600, color: req.status === 'Approved' ? 'var(--brand-green)' : '#ef4444' }}>
                          {req.status === 'Approved' ? (lang === 'en' ? 'Issued' : 'à¤µà¤¿à¤¤à¤°à¤¿à¤¤ à¤à¤¾à¤²à¥‡') : (lang === 'en' ? 'Rejected' : 'à¤¨à¤¾à¤•à¤¾à¤°à¤²à¥‡ à¤—à¥‡à¤²à¥‡')}
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )
  }

  const renderAnnouncementsTab = () => {
    const handlePublishAnnouncement = (e) => {
      e.preventDefault()
      if (!newAnnouncement.title.trim() || !newAnnouncement.details.trim()) return

      const newAnnObj = {
        id: announcements.length + 1,
        title: newAnnouncement.title,
        details: newAnnouncement.details,
        date: new Date().toISOString().split('T')[0]
      }
      setAnnouncements([newAnnObj, ...announcements])
      setNewAnnouncement({ title: '', details: '' })
      alert(lang === 'en' ? 'Announcement published successfully! Ticker updated on landing page.' : 'à¤˜à¥‹à¤·à¤£à¤¾ à¤¯à¤¶à¤¸à¥à¤µà¥€à¤°à¤¿à¤¤à¥à¤¯à¤¾ à¤ªà¥à¤°à¤•à¤¾à¤¶à¤¿à¤¤ à¤•à¥‡à¤²à¥€! à¤®à¥à¤–à¥à¤¯ à¤ªà¤¾à¤¨à¤¾à¤µà¤° à¤¤à¤ªà¤¾à¤¸à¤¾.')
    }

    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: '2rem', width: '100%' }}>
        <div className="admin-content-grid" style={{ gridTemplateColumns: '1.2fr 1.8fr' }}>
          {/* Publisher Form */}
          <div className="admin-card">
            <h3 className="admin-card-title">ðŸ“¢ {lang === 'en' ? 'Publish Panchayat Broadcast' : 'à¤¨à¤µà¥€à¤¨ à¤˜à¥‹à¤·à¤£à¤¾ à¤ªà¥à¤°à¤¸à¤¿à¤¦à¥à¤§ à¤•à¤°à¤¾'}</h3>
            <form onSubmit={handlePublishAnnouncement} style={{ display: 'flex', flexDirection: 'column', gap: '1.25rem' }}>
              <div className="form-group">
                <label>{lang === 'en' ? 'Announcement Title' : 'à¤˜à¥‹à¤·à¤£à¤¾ à¤¶à¥€à¤°à¥à¤·à¤•'}</label>
                <input 
                  type="text" 
                  className="form-input" 
                  style={{ background: 'rgba(255,255,255,0.03)', borderColor: 'rgba(255,255,255,0.1)' }}
                  placeholder={lang === 'en' ? 'e.g. Health Camp Announcement' : 'à¤‰à¤¦à¤¾. à¤®à¥‹à¤«à¤¤ à¤†à¤°à¥‹à¤—à¥à¤¯ à¤¶à¤¿à¤¬à¥€à¤°'}
                  value={newAnnouncement.title}
                  onChange={(e) => setNewAnnouncement({ ...newAnnouncement, title: e.target.value })}
                  required
                />
              </div>
              <div className="form-group">
                <label>{lang === 'en' ? 'Detailed Message' : 'à¤¸à¤µà¤¿à¤¸à¥à¤¤à¤° à¤®à¤œà¤•à¥‚à¤°'}</label>
                <textarea 
                  className="form-textarea" 
                  style={{ background: 'rgba(255,255,255,0.03)', borderColor: 'rgba(255,255,255,0.1)' }}
                  placeholder={lang === 'en' ? 'Write announcement details here...' : 'à¤¯à¥‡à¤¥à¥‡ à¤¸à¤µà¤¿à¤¸à¥à¤¤à¤° à¤˜à¥‹à¤·à¤£à¤¾ à¤®à¤œà¤•à¥‚à¤° à¤²à¤¿à¤¹à¤¾...'}
                  value={newAnnouncement.details}
                  onChange={(e) => setNewAnnouncement({ ...newAnnouncement, details: e.target.value })}
                  required
                ></textarea>
              </div>
              <button type="submit" className="btn btn-primary" style={{ width: '100%', padding: '0.85rem' }}>
                ðŸš€ {lang === 'en' ? 'Publish Live Announcement' : 'à¤˜à¥‹à¤·à¤£à¤¾ à¤¥à¥‡à¤Ÿ à¤ªà¥à¤°à¤¸à¤¿à¤¦à¥à¤§ à¤•à¤°à¤¾'}
              </button>
            </form>
          </div>

          {/* Publisher Log list */}
          <div className="admin-card">
            <h3 className="admin-card-title">ðŸ“‹ {lang === 'en' ? 'Published Broadcasting Log' : 'à¤ªà¥à¤°à¤¸à¤¿à¤¦à¥à¤§ à¤•à¥‡à¤²à¥‡à¤²à¥à¤¯à¤¾ à¤˜à¥‹à¤·à¤£à¤¾à¤‚à¤šà¥€ à¤¨à¥‹à¤‚à¤¦à¤£à¥€'}</h3>
            <div className="admin-table-wrapper">
              <table className="admin-table">
                <thead>
                  <tr>
                    <th>{lang === 'en' ? 'Date' : 'à¤¤à¤¾à¤°à¥€à¤–'}</th>
                    <th>{lang === 'en' ? 'Title' : 'à¤¶à¥€à¤°à¥à¤·à¤•'}</th>
