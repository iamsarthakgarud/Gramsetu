      fetch('/api/complaints/resolve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            setComplaints(prev => prev.map(c => c.id === id ? { ...c, status: 'Resolved' } : c))
          }
        })
        .catch(err => console.error("Error resolving grievance:", err))
