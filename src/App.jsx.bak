                <span className="bar-label" style={{ fontSize: '0.75rem', fontWeight: 600, color: 'var(--dark-text-muted)' }}>
                  {sec === 'Infrastructure' ? (lang === 'en' ? 'Infra' : 'à¤‡à¤¨à¥à¤«à¥à¤°à¤¾')
